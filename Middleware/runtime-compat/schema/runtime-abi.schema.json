{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nea.local/schema/runtime-abi.schema.json",
  "title": "NEA Runtime ABI Catalog",
  "type": "object",
  "required": ["format", "version", "generatedAt", "entries"],
  "properties": {
    "format": { "const": "nea-runtime-abi" },
    "version": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "side", "kind", "availability", "compatibility", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "side": { "enum": ["client", "server", "shared", "transport", "physics"] },
        "kind": { "enum": ["global", "object", "property", "method", "event", "constructor", "protocol", "schema", "profile"] },
        "owner": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "signature": { "type": "object" },
        "kinds": {
          "type": "array",
          "items": { "enum": ["global", "object", "property", "method", "event", "constructor"] },
          "uniqueItems": true
        },
        "kindCollision": { "type": "boolean" },
        "memberVariants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "signature", "evidence"],
            "properties": {
              "kind": { "enum": ["global", "object", "property", "method", "event", "constructor"] },
              "signature": { "type": "object" },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          }
        },
        "binding": { "type": "object" },
        "availability": { "enum": ["confirmed", "partial", "declared", "unknown", "unsupported"] },
        "compatibility": { "enum": ["native", "bridged", "emulated", "missing"] },
        "capability": { "type": ["string", "null"] },
        "since": { "type": ["string", "null"] },
        "implements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "notes": { "type": "array", "items": { "type": "string" } },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "path", "confidence"],
            "properties": {
              "type": { "enum": ["docs", "player-bundle", "protocol-schema", "origin-source", "external-reference-source", "local-source", "derived"] },
              "path": { "type": "string" },
              "symbol": { "type": ["string", "null"] },
              "confidence": { "enum": ["direct", "derived", "hypothesis"] }
            }
          }
        }
    }
  }
